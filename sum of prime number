public class SumOfPrimes {
    public static void main(String[] args) {
        int sum = 0;

        for (int num = 2; num <= 50; num++) {
            if (isPrime(num)) {
                sum += num;
            }
        }

        System.out.println("Sum of prime numbers from 1 to 50 is: " + sum);
    }

    // Method to check prime
    public static boolean isPrime(int n) {
        if (n <= 1) return false;

        for (int i = 2; i <= n / 2; i++) {
            if (n % i == 0) {
                return false;
            }
        }
        return true;
    }
}
