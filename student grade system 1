import java.io.*;
import java.util.*;

public class Solution {

    public static void main(String[] args) {
        int num;
        Scanner sc=new Scanner(System.in);
        num=sc.nextInt();
        if (num>=90 )
        {
            System.out.println("A");
        }
        else if (num>=75 )
        {
        System.out.println("B");    
        }
        else if (num>=60 )
        {
        System.out.println("C");    
        }
        else {
            System.out.println("Fail");    
        }
     
    }
}
