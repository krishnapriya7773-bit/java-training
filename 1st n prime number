import java.util.Scanner;

public class PrimeNumbers {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);

        System.out.print("Enter value of n: ");
        int n = sc.nextInt();

        int count = 0, num = 2;

        while (count < n) {
            int i;

            for (i = 2; i <= num / 2; i++) {
                if (num % i == 0) {
                    break;
                }
            }

            if (i > num / 2) {
                System.out.print(num + " ");
                count++;
            }

            num++;
        }
    }
}

